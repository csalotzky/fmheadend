{
  "name": "fmheadend-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:branding-assets": "node --test tests/branding-assets.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "format:check": "prettier --check src",
    "prepare:branding": "node scripts/prepare-branding-assets.mjs",
    "preng": "npm run prepare:branding",
    "prestart": "npm run prepare:branding",
    "prebuild": "npm run prepare:branding",
    "prewatch": "npm run prepare:branding",
    "pretest": "npm run prepare:branding"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.6",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11 <13"
  }
}
